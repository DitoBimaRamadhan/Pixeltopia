; Engine configuration file — Pixeltopia auth + shards (v0.8)
config_version=5

[application]
config/name="Pixeltopia"
config/description="Original 2D sandbox farming prototype. Not affiliated with Growtopia or any other commercial game."
run/main_scene="res://scenes/auth/login.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
config/version="0.8.0"

[autoload]
Session="*res://scripts/auth/session.gd"
Sfx="*res://scripts/sfx.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.45, 0.72, 0.95, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
