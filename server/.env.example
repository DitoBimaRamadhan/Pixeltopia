# Copy to server/.env (gitignored) for local runs; on a host set these as env vars.
# Postgres (Neon/Supabase). Leave empty to use JSON files in server/data/.
DATABASE_URL=
# pg (TCP 5432, default) or neon (WebSocket 443, if 5432 is blocked)
PG_DRIVER=pg
# Long random string — required in production
JWT_SECRET=
SAVE_INTERVAL_MS=30000
# Server-authoritative inventory (wallet, drops, shop/craft/splice/quests/trades on the server). Off unless 1.
SERVER_INV=
# Minimum client protocol. 2 = v1.7.0+; older APKs get an "update required" message. 0/unset = no gate.
MIN_PROTO=
# Where old clients are sent to update (default: GitHub releases/latest)
UPDATE_URL=
